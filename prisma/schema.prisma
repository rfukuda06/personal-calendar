generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users ----------

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String?
  image                String?
  googleId             String   @unique
  // Global toggle. When false the cron skips this user entirely.
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categories      Category[]
  events          Event[]
  bigEvents       BigEvent[]
  todos           Todo[]
  dueDates        DueDate[]
  reminders       Reminder[]
  todoDigestSends TodoDigestSend[]
}

// ---------- Categories (user-defined labels with a color) ----------

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String // hex, e.g. "#ef4444"

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
  bigEvents BigEvent[]
  dueDates  DueDate[]

  @@unique([userId, name])
  @@index([userId])
}

// ---------- Timed events ----------

model Event {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  title      String
  notes      String?
  startUtc   DateTime
  endUtc     DateTime
  rrule      String? // RFC 5545 RRULE string, null = single occurrence
  // Last possible occurrence start of the series, or null for an open-ended
  // RRULE (no UNTIL/COUNT). Denormalized from `rrule` on write so the events
  // list query can prune series that have already finished without expanding
  // them. Always null for non-recurring rows.
  seriesEndUtc DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exceptions EventException[]
  reminders  Reminder[]

  @@index([userId, startUtc])
}

// Per-occurrence override for a recurring Event.
// Covers: cancel this one, retitle this one, move this one's time, recategorize
// this one. A null overrideCategoryId means "inherit the series category" (same
// convention as BigEventException / DueDateException), so a single occurrence
// can't be cleared to "no category" independently of its series.
model EventException {
  id                 String    @id @default(cuid())
  eventId            String
  originalStartUtc   DateTime
  cancelled          Boolean   @default(false)
  overrideTitle      String?
  overrideNotes      String?
  overrideStartUtc   DateTime?
  overrideEndUtc     DateTime?
  overrideCategoryId String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStartUtc])
}

// ---------- Big events (all-day, no time) ----------
// birthdays, midterms, tournaments, etc.

model BigEvent {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  title      String
  notes      String?
  date       DateTime @db.Date // calendar day in America/Los_Angeles
  rrule      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exceptions BigEventException[]
  reminders  Reminder[]

  @@index([userId, date])
}

// Per-occurrence override for a recurring BigEvent. Mirrors EventException.
model BigEventException {
  id                 String   @id @default(cuid())
  bigEventId         String
  originalDate       DateTime @db.Date
  cancelled          Boolean  @default(false)
  overrideTitle      String?
  overrideNotes      String?
  overrideCategoryId String?

  bigEvent BigEvent @relation(fields: [bigEventId], references: [id], onDelete: Cascade)

  @@unique([bigEventId, originalDate])
}

// ---------- Todos ----------

model Todo {
  id          String    @id @default(cuid())
  userId      String
  title       String
  notes       String?
  dueDate     DateTime  @db.Date // calendar day in America/Los_Angeles
  rrule       String?
  completedAt DateTime? // for non-recurring todos
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions TodoCompletion[]
  exceptions  TodoException[]

  @@index([userId, dueDate])
}

// Per-occurrence override for a recurring Todo (separate from TodoCompletion,
// which only tracks completion state). Same shape as EventException.
model TodoException {
  id             String   @id @default(cuid())
  todoId         String
  occurrenceDate DateTime @db.Date
  cancelled      Boolean  @default(false)
  overrideTitle  String?
  overrideNotes  String?

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([todoId, occurrenceDate])
}

// Per-occurrence completion for recurring Todos.
// Non-recurring todos use Todo.completedAt directly.
model TodoCompletion {
  id             String   @id @default(cuid())
  todoId         String
  occurrenceDate DateTime @db.Date
  completedAt    DateTime @default(now())

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([todoId, occurrenceDate])
}

// ---------- Due dates (timed deadlines, shown above the calendar grid) ----------
// Distinct from Events (no duration), BigEvents (no time), Todos (no
// completion concept). Multiple per day; rendered as a strip under the
// all-day bar.

model DueDate {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  title      String
  dueAt      DateTime // UTC datetime
  rrule      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exceptions DueDateException[]
  reminders  Reminder[]

  @@index([userId, dueAt])
}

// Per-occurrence override for a recurring DueDate.
model DueDateException {
  id                 String   @id @default(cuid())
  dueDateId          String
  originalDueAt      DateTime
  cancelled          Boolean  @default(false)
  overrideTitle      String?
  overrideDueAt      DateTime?
  overrideCategoryId String?

  dueDate DueDate @relation(fields: [dueDateId], references: [id], onDelete: Cascade)

  @@unique([dueDateId, originalDueAt])
}

// ---------- Reminders ----------
//
// One row per (parent, offset). A single event can have multiple reminders
// stacked (e.g. 1 week + 1 day + 30 min). Exactly one of eventId / bigEventId
// / dueDateId is non-null — discriminator-style polymorphism matching the
// rest of this schema (see Category's per-entity collections).
//
// `offsetMinutes` applies to Event and DueDate (minutes before start).
// `daysBefore` applies to BigEvent only — fire time is (date - N days) at
// 22:00 LA, so the time-of-day is fixed. This split keeps each entity's
// reminder semantics explicit on the row.
model Reminder {
  id            String   @id @default(cuid())
  userId        String
  eventId       String?
  bigEventId    String?
  dueDateId     String?
  offsetMinutes Int?
  daysBefore    Int?
  createdAt     DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bigEvent BigEvent? @relation(fields: [bigEventId], references: [id], onDelete: Cascade)
  dueDate  DueDate?  @relation(fields: [dueDateId], references: [id], onDelete: Cascade)

  sends ReminderSend[]

  @@index([userId])
  @@index([eventId])
  @@index([bigEventId])
  @@index([dueDateId])
}

// Idempotency log: one row per (Reminder, occurrence) actually emailed.
// `occurrenceKey` is the ISO datetime of the instance start (BigEvent uses
// the date-only ISO). Non-recurring parents have a single occurrenceKey
// equal to their own start. Unique constraint is the safety net against
// double-sends if the cron job overlaps itself.
model ReminderSend {
  id            String   @id @default(cuid())
  reminderId    String
  occurrenceKey String
  sentAt        DateTime @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, occurrenceKey])
}

// One row per user per day a 12pm-LA todo digest was emailed. Prevents the
// cron from sending two digests if it overlaps the noon minute twice.
model TodoDigestSend {
  id         String   @id @default(cuid())
  userId     String
  digestDate DateTime @db.Date
  sentAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDate])
}
