DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
# DIRECT_URL is used by `prisma migrate` only. In production (Neon) set this
# to the non-pooled connection string so migrations don't acquire advisory
# locks through the pooler. Locally just mirror DATABASE_URL.
DIRECT_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Gmail SMTP for reminder emails (used by src/scripts/send-reminders.ts).
# Enable 2-Step Verification on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 chars (no spaces).
# GMAIL_USER is the full address; it's also the From on outgoing mail.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
APP_URL="http://localhost:3000"
