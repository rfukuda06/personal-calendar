DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
# DIRECT_URL is used by `prisma migrate` only. In production (Neon) set this
# to the non-pooled connection string so migrations don't acquire advisory
# locks through the pooler. Locally just mirror DATABASE_URL.
DIRECT_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend transactional email (used by src/scripts/send-reminders.ts).
# EMAIL_FROM must be a prefix on a domain you've verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""
APP_URL="http://localhost:3000"
