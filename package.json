{
  "name": "personal_calendar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "reminders:cron": "tsx src/scripts/send-reminders.ts",
    "cal": "tsx -r dotenv/config src/scripts/cal.ts",
    "cal:prod": "tsx -r dotenv/config -r ./src/scripts/use-prod-db.ts src/scripts/cal.ts",
    "mcp:build": "esbuild src/mcp/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/mcp/server.mjs --external:@prisma/client --external:@prisma/adapter-pg --external:./src/generated/prisma/client",
    "cli:build": "esbuild src/scripts/cal.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli/cal.mjs --main-fields=module,main --external:@prisma/client --external:@prisma/adapter-pg --external:./src/generated/prisma/client --banner:js=\"import{createRequire as _cr}from'module';const require=_cr(import.meta.url);\"",
    "mcp:dev": "tsx -r dotenv/config -r ./src/scripts/use-prod-db.ts src/mcp/server.ts",
    "mcp:test": "npm run mcp:build && tsx -r dotenv/config -r ./src/scripts/use-prod-db.ts src/scripts/test-mcp.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "^5.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.9.0",
    "luxon": "^3.7.2",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "resend": "^6.12.3",
    "rrule": "^2.8.1",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
